<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_popup_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp">

        <!-- 5 Colonne per zona stile scout IN ALTO (P.4, P.3, P.2, P.1, P/O) per un tocco immediato -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <!-- P.4 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="2dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_col_posto4_header"
                    style="@style/AttackColumnHeader"
                    android:text="P.4" />

                <LinearLayout
                    android:id="@+id/layout_col_posto4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

            </LinearLayout>

            <!-- P.3 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="2dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_col_posto3_header"
                    style="@style/AttackColumnHeader"
                    android:text="P.3" />

                <LinearLayout
                    android:id="@+id/layout_col_posto3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

            </LinearLayout>

            <!-- P.2 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="2dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_col_posto2_header"
                    style="@style/AttackColumnHeader"
                    android:text="P.2" />

                <LinearLayout
                    android:id="@+id/layout_col_posto2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

            </LinearLayout>

            <!-- P.1 (1.0 e 1.G) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="2dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_col_posto1_header"
                    style="@style/AttackColumnHeader"
                    android:text="P.1" />

                <LinearLayout
                    android:id="@+id/layout_col_posto1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

            </LinearLayout>

            <!-- P / O (Pipe / Opposto) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="2dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_col_seconda_linea_header"
                    style="@style/AttackColumnHeader"
                    android:text="P/O" />

                <LinearLayout
                    android:id="@+id/layout_col_seconda_linea"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

            </LinearLayout>

        </LinearLayout>

        <!-- Barra orologio e titolo in BASSO (sotto i pulsanti) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="2dp">

            <Button
                android:id="@+id/btn_attack_duration"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="⏱️ 3s"
                android:textColor="@color/accent_blue"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/btn_icon_bg"
                android:paddingHorizontal="10dp"
                android:contentDescription="Cambia durata clip" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="📌 Tipo di attacco"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
